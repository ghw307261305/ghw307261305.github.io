---
interface Props { name: 'arrow' | 'search' | 'download' | 'mail' | 'menu' | 'close'; size?: number; }
const { name, size = 16 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><line x1="4" y1="12" x2="20" y2="12"></line><polyline points="14 6 20 12 14 18"></polyline></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></>}
  {name === 'download' && <><path d="M12 4v11"></path><polyline points="7 10 12 15 17 10"></polyline><path d="M4 19h16"></path></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1"></rect><polyline points="3 7 12 13 21 7"></polyline></>}
  {name === 'menu' && <><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></>}
  {name === 'close' && <><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></>}
</svg>
