---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import SectionHead from '../../components/SectionHead.astro';
import { langs, sections, t, type Lang } from '../../i18n';
import { getArticles } from '../../i18n/articles';
import { getCollection } from 'astro:content';

export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const s = t(lang);
const all = await getArticles(lang);
const startHere = all.filter((a) => a.data.startHere).sort((a, b) => a.data.startHere! - b.data.startHere!).slice(0, 3);
const bySection = Object.fromEntries(sections.map((sec) => [sec, all.filter((a) => a.data.section === sec).slice(0, 3)]));
const tools = (await getCollection('tools')).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime()).slice(0, 3);
const nums = ['01', '02', '03', '04'];
---
<Base lang={lang} path="">
  <section class="grid-paper hero-band">
    <div class="wrap hero">
      <div class="hero-text">
        <span class="eyebrow">{s.heroEyebrow}</span>
        <h1 class="mincho">{s.heroTitle}</h1>
        <p>{s.heroLead}</p>
        <div class="ctas">
          <a class="btn primary" href="#start">{s.ctaStart}<Icon name="arrow" /></a>
          <a class="btn" href={`/${lang}/about/`}>{s.ctaAbout}</a>
        </div>
      </div>
      <div class="card start" id="start">
        <div class="start-h"><span class="mincho">{s.startHere}</span><span class="eyebrow">Start here</span></div>
        {startHere.map((a, i) => (
          <a class="start-row" href={`/${lang}/${a.key}/`}>
            <span class="mincho n">{String(i + 1).padStart(2, '0')}</span>
            <span class="txt"><span class="ttl">{a.data.title}</span><span class="crumb">{s.nav[a.data.section]} › {a.data.tag}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap main">
    <div class="sections">
      {sections.map((sec, i) => (
        <div class="sec">
          <SectionHead num={nums[i]} title={s.nav[sec]} desc={s.sectionDesc[sec]} href={`/${lang}/${sec}/`} moreLabel={s.seeAll} />
          <ul>{bySection[sec].map((a) => <ArticleRow a={a} lang={lang} />)}</ul>
        </div>
      ))}
    </div>
    <aside class="rail">
      <div class="card author">
        <span class="rail-h">{s.author}</span>
        <div class="who">
          <div class="avatar"></div>
          <div><span class="mincho nm">{s.authorName}</span><span class="role">{s.authorRole}</span></div>
        </div>
        <p>{s.authorBio}</p>
        <a class="more" href={`/${lang}/about/`}>{s.aboutFull}<Icon name="arrow" size={14} /></a>
      </div>
      <div class="card gl">
        <span class="rail-h">{s.glossary}</span>
        <p>{s.glossaryCard}</p>
        <a class="more" href={`/${lang}/glossary/`}>{s.openGlossary}<Icon name="arrow" size={14} /></a>
      </div>
    </aside>
  </section>

  <section class="tools-band">
    <div class="wrap">
      <div class="tb-head">
        <div><h2 class="mincho">{s.tools}</h2><span class="desc">{s.toolsBand}</span></div>
        <a class="more" href={`/${lang}/tools/`}>{s.seeAll}<Icon name="arrow" size={14} /></a>
      </div>
      <div class="tb-grid">
        {tools.map((tl) => (
          <a class="card tool" href={`/${lang}/tools/#${tl.data.id}`}>
            <div class="tool-top"><span class="pill">{tl.data.format}</span></div>
            <span class="ttl">{tl.data.name[lang]}</span>
            <span class="desc">{tl.data.description[lang]}</span>
            <div class="langs">{langs.map((l) => <span class:list={['pill', { off: !tl.data.langs.includes(l) }]}>{l.toUpperCase()}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .hero-band { border-bottom: 1px solid var(--line); }
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) 440px; gap: 96px; padding-top: 88px; padding-bottom: 80px; align-items: start; }
  .hero-text { display: flex; flex-direction: column; gap: 28px; }
  .hero h1 { font-size: 44px; line-height: 1.5; font-weight: 600; letter-spacing: 0.02em; }
  .hero p { font-size: 16px; line-height: 2; color: var(--ink-2); max-width: 620px; }
  .ctas { display: flex; gap: 14px; margin-top: 6px; flex-wrap: wrap; }
  .start { padding: 28px 28px 12px; display: flex; flex-direction: column; gap: 6px; }
  .start-h { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; border-bottom: 2px solid var(--ink); }
  .start-h .mincho { font-size: 18px; font-weight: 600; letter-spacing: 0.08em; }
  .start-row { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--line-2); align-items: start; color: var(--ink); }
  .start-row:last-child { border-bottom: 0; }
  .start-row .n { font-size: 22px; color: var(--accent); line-height: 1.3; }
  .start-row .txt { display: flex; flex-direction: column; gap: 4px; }
  .start-row .ttl { font-size: 15px; font-weight: 700; line-height: 1.6; }
  .start-row:hover .ttl { color: var(--accent); }
  .start-row .crumb { font-size: 12px; color: var(--ink-3); }
  .main { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 72px; padding-top: 64px; padding-bottom: 72px; }
  .sections { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 48px; }
  .sec { display: flex; flex-direction: column; gap: 4px; }
  .rail { display: flex; flex-direction: column; gap: 28px; }
  .rail .card { padding: 24px; }
  .rail p { font-size: 13px; line-height: 1.8; color: var(--ink-2); margin-top: 12px; }
  .rail .more { margin-top: 12px; }
  .who { display: flex; gap: 16px; align-items: center; margin-top: 14px; }
  .who > div { display: flex; flex-direction: column; gap: 2px; }
  .avatar { width: 56px; height: 56px; border-radius: 50%; background: #E4DFD5; border: 1px solid var(--line-3); flex-shrink: 0; }
  .nm { font-size: 17px; font-weight: 600; letter-spacing: 0.06em; }
  .role { font-size: 12px; color: var(--ink-3); }
  .tools-band { border-top: 1px solid var(--line); background: var(--paper-2); padding: 56px 0 64px; }
  .tb-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 28px; gap: 16px; }
  .tb-head > div { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .tb-head h2 { font-size: 22px; font-weight: 600; letter-spacing: 0.06em; }
  .tb-head .desc { font-size: 12px; color: var(--ink-3); }
  .tb-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .tool { padding: 22px 24px; display: flex; flex-direction: column; gap: 10px; color: var(--ink); }
  .tool-top { display: flex; justify-content: space-between; align-items: center; color: var(--ink-2); }
  .tool .ttl { font-size: 15px; font-weight: 700; line-height: 1.6; } .tool:hover .ttl { color: var(--accent); }
  .tool .desc { font-size: 12px; color: var(--ink-3); }
  .langs { display: flex; gap: 4px; }
  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 56px; padding-bottom: 48px; }
    .hero h1 { font-size: 34px; }
    .main { grid-template-columns: 1fr; gap: 48px; }
    .rail { flex-direction: row; flex-wrap: wrap; } .rail > * { flex: 1 1 280px; }
  }
  @media (max-width: 768px) {
    .hero { padding-top: 40px; padding-bottom: 36px; }
    .hero h1 { font-size: 26px; line-height: 1.55; }
    .hero p { font-size: 14px; }
    .sections { grid-template-columns: 1fr; gap: 36px; }
    .main { padding-top: 32px; padding-bottom: 40px; gap: 32px; }
    .tb-grid { grid-template-columns: 1fr; }
    .tools-band { padding: 32px 0 40px; }
  }
</style>
