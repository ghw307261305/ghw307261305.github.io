---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { langs, t, type Lang } from '../../i18n';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const s = t(lang);
const memoLang: 'ja' | 'zh' = lang === 'zh' ? 'zh' : 'ja';
const rows = await getCollection('glossary');
const c = {
  ja: { eyebrow: 'Glossary · JA / ZH / EN', intro: '日本の案件でしか通じない言葉、直訳すると意味がずれる言葉を、現場で使われている中国語と並べています。英語は参考として三列目に置きました。', search: '日本語・中文・English で検索', all: 'すべて', cats: { process: '工程', contract: '契約・商流', ops: '運用・障害', salesforce: 'Salesforce' }, cols: ['日本語', '中文', 'English', '補足 · 現場での使われ方', '分類'], foot: '語の追加・訂正の提案は、お問い合わせから。' },
  zh: { eyebrow: 'Glossary · JA / ZH / EN', intro: '只在日本项目里通用的词、直译会跑偏的词，和一线实际在用的中文并排。英文作为参考放在第三列。', search: '用日语・中文・英语搜索', all: '全部', cats: { process: '工程', contract: '合同・商流', ops: '运维・故障', salesforce: 'Salesforce' }, cols: ['日本語', '中文', 'English', '补充 · 一线怎么用', '分类'], foot: '想补充或纠正词条，请通过联系页告诉我。' },
  en: { eyebrow: 'Glossary · JA / ZH / EN', intro: 'Terms that only make sense inside Japanese IT projects, or drift in meaning when translated literally, side by side with the Chinese actually used on site. English is a reference column; notes are in Japanese.', search: 'Search in Japanese, Chinese or English', all: 'All', cats: { process: 'Process', contract: 'Contracts', ops: 'Operations', salesforce: 'Salesforce' }, cols: ['日本語', '中文', 'English', 'Notes (JA)', 'Category'], foot: 'Suggest additions or corrections via the contact page.' },
}[lang];
---
<Base lang={lang} title={s.glossary} description={c.intro} path="glossary/" available={['ja', 'zh']}>
  <section class="grid-paper">
    <div class="wrap page-hero">
      <div class="intro"><span class="eyebrow">{c.eyebrow}</span><h1>{s.glossary}</h1><p>{c.intro}</p></div>
    </div>
  </section>
  <section class="wrap body">
    <div class="bar">
      <label class="search"><Icon name="search" size={18} /><input type="search" placeholder={c.search} data-glossary-search /></label>
      <div class="tags" data-glossary-cats>
        <button type="button" class="tag on" data-cat="">{c.all}</button>
        {Object.entries(c.cats).map(([k, n]) => <button type="button" class="tag" data-cat={k}>{n}</button>)}
      </div>
    </div>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr>{c.cols.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr data-cat={r.data.category} data-text={`${r.data.ja} ${r.data.zh} ${r.data.en}`.toLowerCase()}>
              <td class="ja">{r.data.ja}</td><td>{r.data.zh}</td><td class="en">{r.data.en}</td>
              <td class="memo">{r.data.memo[memoLang]}</td>
              <td><span class="pill">{c.cats[r.data.category]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="foot">{c.foot}</p>
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-glossary-search]');
  const cats = document.querySelector('[data-glossary-cats]');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-cat]')];
  let cat = '';
  const apply = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    for (const r of rows) r.hidden = (cat && r.dataset.cat !== cat) || (!!q && !r.dataset.text!.includes(q));
  };
  input?.addEventListener('input', apply);
  cats?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]');
    if (!b) return;
    cat = b.dataset.cat ?? '';
    cats.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    apply();
  });
</script>
<style>
  .body { padding-top: 48px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 32px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .search { display: flex; align-items: center; gap: 12px; width: 420px; max-width: 100%; height: 44px; padding: 0 16px; border: 1px solid var(--line); background: var(--white); border-radius: 2px; color: var(--ink-3); }
  .search input { border: 0; outline: 0; background: transparent; font: inherit; font-size: 14px; color: var(--ink); flex: 1; min-width: 0; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tags .tag { height: 28px; padding: 0 12px; cursor: pointer; font-family: inherit; }
  .tbl-wrap { overflow-x: auto; }
  .tbl td:nth-child(1), .tbl td:nth-child(2) { width: 200px; } .tbl td:nth-child(3) { width: 240px; }
  .foot { font-size: 13px; color: var(--ink-3); }
  @media (max-width: 768px) { .body { padding-top: 28px; padding-bottom: 48px; gap: 20px; } .tbl td:nth-child(1), .tbl td:nth-child(2), .tbl td:nth-child(3) { width: auto; min-width: 140px; } }
</style>
