      ['Japan–China bridge', 'Spec hand-offs, reviews, and progress visibility with development teams in China. Before a Japanese spec gets thrown over the wall as-is.', 'Spot / Ongoing'],
    ]},
    flow: { h: 'How an engagement works', steps: [['Get in touch', 'A few bullet points about what is stuck is enough.'], ['30-minute call', 'Free. Many problems end here.'], ['Quote and agreement', 'Scope and deliverables in writing.'], ['Start', 'Weekly progress reports.']] },
    anon: { h: 'About the case notes', desc: 'Anonymization policy', rules: ['No company names, product names, or client-specific business terms. Industry and rough size only.', 'Timelines are shifted and elements of several projects may be combined. Nothing can be traced back to one project.', 'Only technical decisions and how the work was run. No evaluations of individuals, nothing about contract terms.', 'If someone involved asks after publication, the content is corrected or withdrawn.'] },
    contact: { h: 'Contact', text: 'Japanese, Chinese, or English. I usually reply within two business days.', btn: 'Email me' },
  },
}[lang];
---
<Base lang={lang} title={s.aboutFull} description={c.bio[0]} path="about/">
  <section class="grid-paper">
    <div class="wrap page-hero">
      <div class="intro"><span class="eyebrow">{c.eyebrow}</span><h1>{c.title}</h1></div>
    </div>
  </section>
  <section class="wrap body">
    <aside class="profile sticky" id="operator">
      <div class="photo"></div>
      <div class="id">
        <span class="mincho nm">{s.authorName}</span>
        <span class="role">{c.role}</span>
        <span class="base">{c.base}</span>
      </div>
      <dl>{c.dl.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </aside>
    <div class="content">
      <div class="prose bio">{c.bio.map((p) => <p>{p}</p>)}</div>

      <div class="block">
        <SectionHead num="01" title={c.career.h} />
        <div class="tbl-wrap">
          <table class="tbl career">
            <thead><tr>{c.career.cols.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>{c.career.rows.map(([a, p, d]) => <tr><td class="ja">{a}</td><td class="date">{p}</td><td class="memo">{d}</td></tr>)}</tbody>
          </table>
        </div>
      </div>

      <div class="block">
        <SectionHead num="02" title={c.projects.h} desc={c.projects.desc} />
        <ul>
          {c.projects.items.map(([ind, name, role, what]) => (
            <li class="prj">
              <span class="tag">{ind}</span>
              <span class="prj-body">
                <span class="prj-n">{name}</span>
                <span class="prj-r mono">{role}</span>
                <span class="prj-d">{what}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="block">
        <SectionHead num="03" title={c.certs.h} />
        <div class="certs">
          {c.certs.groups.map(([g, list]) => (
            <div class="cert-g">
              <span class="cert-h">{g}</span>
              <ul class="cert-l">{(list as string[]).map((x) => <li>{x}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>

      <div class="block">
        <SectionHead num="04" title={c.services.h} />
        {c.services.items.map(([n, d, k]) => <div class="svc"><span class="svc-n">{n}</span><span class="svc-d">{d}</span><span class="pill">{k}</span></div>)}
      </div>
      <div class="block">
        <SectionHead num="05" title={c.flow.h} />
        <div class="steps">{c.flow.steps.map(([n, d], i) => <div class="step"><span class="mincho sn">{i + 1}</span><span class="st">{n}</span><span class="sd">{d}</span></div>)}</div>
      </div>
      <div class="block">
        <SectionHead num="06" title={c.anon.h} desc={c.anon.desc} />
        <ul class="note rules">{c.anon.rules.map((r) => <li>{r}</li>)}</ul>
      </div>
      <div class="block" id="contact">
        <SectionHead num="07" title={c.contact.h} />
        <div class="contact">
          <p>{c.contact.text}</p>
          <a class="btn primary" href="mailto:"><Icon name="mail" />{c.contact.btn}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .body { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 96px; padding-top: 64px; padding-bottom: 80px; align-items: start; }
  .profile { display: flex; flex-direction: column; gap: 20px; }
  .photo { width: 200px; height: 240px; background: #E4DFD5; border: 1px solid var(--line-3); }
  .id { display: flex; flex-direction: column; gap: 4px; }
  .nm { font-size: 24px; font-weight: 600; letter-spacing: 0.08em; }
  .role { font-size: 13px; color: var(--ink-2); } .base { font-size: 13px; color: var(--ink-3); }
  dl { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 8px 12px; font-size: 13px; border-top: 1px solid var(--line); padding-top: 16px; }
  dt { color: var(--ink-3); } dd { margin: 0; line-height: 1.7; }
  .content { display: flex; flex-direction: column; gap: 56px; max-width: 760px; }
  .bio { display: flex; flex-direction: column; gap: 16px; }
  .block { display: flex; flex-direction: column; gap: 4px; }
  .tbl-wrap { overflow-x: auto; padding-top: 12px; }
  .career td:nth-child(1) { width: 190px; } .career td:nth-child(2) { width: 90px; } .career td.memo { color: var(--ink-2); }
  .prj { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line-2); align-items: start; }
  .prj .tag { justify-self: start; margin-top: 2px; }
  .prj-body { display: flex; flex-direction: column; gap: 4px; }
  .prj-n { font-size: 15px; font-weight: 700; line-height: 1.6; }
  .prj-r { font-size: 11px; color: var(--accent); letter-spacing: 0.06em; }
  .prj-d { font-size: 14px; color: var(--ink-2); line-height: 1.8; }
  .certs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; padding-top: 20px; }
  .cert-g { display: flex; flex-direction: column; gap: 8px; }
  .cert-h { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .cert-l li { font-size: 13px; color: var(--ink-2); line-height: 1.9; padding-left: 14px; position: relative; }
  .cert-l li::before { content: ""; position: absolute; left: 0; top: 12px; width: 6px; height: 1px; background: var(--accent); }
  .svc { display: grid; grid-template-columns: 180px minmax(0, 1fr) 120px; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line-2); align-items: start; }
  .svc-n { font-size: 15px; font-weight: 700; } .svc-d { font-size: 14px; color: var(--ink-2); line-height: 1.8; }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; padding-top: 24px; }
  .step { display: flex; flex-direction: column; gap: 8px; }
  .sn { font-size: 26px; color: var(--accent); } .st { font-size: 14px; font-weight: 700; } .sd { font-size: 13px; color: var(--ink-2); line-height: 1.7; }
  .rules { display: flex; flex-direction: column; gap: 2px; padding-top: 16px; }
  .contact { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; gap: 24px; flex-wrap: wrap; }
  .contact p { font-size: 14px; color: var(--ink-2); line-height: 1.8; }
  @media (max-width: 1100px) { .body { grid-template-columns: 1fr; gap: 48px; } .profile { flex-direction: row; flex-wrap: wrap; align-items: flex-start; } dl { flex: 1 1 260px; border-top: 0; padding-top: 0; } }
  @media (max-width: 768px) { .body { padding-top: 32px; padding-bottom: 48px; } .svc { grid-template-columns: 1fr; gap: 6px; } .steps, .certs { grid-template-columns: repeat(2, minmax(0, 1fr)); } .photo { width: 120px; height: 144px; } .career td:nth-child(1) { width: 130px; } .prj { grid-template-columns: 1fr; gap: 6px; } }
</style>
